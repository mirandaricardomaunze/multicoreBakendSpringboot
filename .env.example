# Copiar para .env e preencher. NUNCA commitar o .env real (já está no .gitignore).
#
#   cp .env.example .env && nano .env

# Domínio público a apontar para o VPS (para o HTTPS automático do Caddy).
DOMAIN=erp.exemplo.co.mz

# PostgreSQL (fica na rede interna do compose, nunca exposto ao exterior).
DB_NAME=multicore
DB_USER=multicore
DB_PASSWORD=TROCAR-por-uma-password-longa-e-aleatoria

# Cifra dos anexos clínicos: obrigatória. Gerar com: openssl rand -base64 32
# Guardar uma cópia fora do servidor: perder a chave é perder os anexos cifrados.
ATTACHMENT_KEY=

# Senha do superadmin, usada na criação da conta e para a recuperar se ainda tiver uma senha de
# demonstração: nesse caso o arranque recusa-se sem esta variável. Vazia = a conta não é criada.
SUPERADMIN_PASSWORD=

# Versão do PostgreSQL. Deve coincidir com a BD existente para o backup/restore físico
# funcionar (o pg_dump do cliente tem de ser >= à do servidor). O ambiente atual usa 18.
POSTGRES_IMAGE=postgres:16
PG_MAJOR=16

# Versão mínima do programa desktop aceite. Ao subir, os postos com versão anterior são
# recusados e vêem o botão "Descarregar actualização" (https://DOMAIN/downloads/).
# Publicar primeiro o instalador novo (scripts/publicar-instalador.sh), só depois subir isto.
APP_CLIENT_MIN_VERSION=0.0.0
